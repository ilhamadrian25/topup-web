# <DEPLOY_DIR>/.env — production config, NOT committed. chmod 600.
# Read by docker compose (stack settings) and passed to the app container (env_file).

# ---- Stack ----
# Image to run. deploy.sh overrides this with the exact tag it deploys.
IMAGE=ghcr.io/your-github-user/topup-web:latest
# Host address:port the app listens on for your reverse proxy (see docker-compose.yml).
APP_BIND=127.0.0.1:3000
# Postgres password for the bundled database. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- App ----
# Session signing secret (>= 32 chars). Generate: openssl rand -base64 48
# Moving an existing install? Use the SAME values as before: payment gateway
# credentials in the DB are encrypted with CONFIG_ENCRYPTION_KEY (fallback AUTH_SECRET).
AUTH_SECRET=
CONFIG_ENCRYPTION_KEY=

APP_URL=https://your-domain.example

# Biller: "mock" | "payterra"
BILLER_PROVIDER=mock
PAYTERRA_BASE_URL=
PAYTERRA_MERCHANT_ID=
PAYTERRA_API_KEY=
PAYTERRA_CALLBACK_SECRET=

ALLOW_MOCK_PAYMENT=false
PAYMENT_EXPIRY_MINUTES=60

# Admin uploads: leave SUPABASE_* empty to store them in the `uploads` volume.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Sync produk/harga otomatis: scheduler internal aktif default (interval di admin > Pengaturan).
# Opsional: CRON_SECRET untuk memanggil POST /api/cron/sync-products dari cron eksternal (Bearer token);
# DISABLE_INTERNAL_CRON=1 untuk mematikan scheduler internal.
CRON_SECRET=

