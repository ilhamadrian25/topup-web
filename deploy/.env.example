# /opt/topupin/.env — rahasia produksi, JANGAN di-commit. chmod 600.

# Password Postgres lokal stack topupin. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=""

# WAJIB sama dengan nilai produksi lama (Vercel). Kredensial payment gateway di DB
# terenkripsi dengan CONFIG_ENCRYPTION_KEY (fallback AUTH_SECRET) — kalau beda, iPaymu tidak bisa didekripsi
# dan semua member harus login ulang.
AUTH_SECRET=""
CONFIG_ENCRYPTION_KEY=""

APP_URL="https://www.topupin.xyz"

BILLER_PROVIDER="mock"
PAYTERRA_BASE_URL=""
PAYTERRA_MERCHANT_ID=""
PAYTERRA_API_KEY=""
PAYTERRA_CALLBACK_SECRET=""

ALLOW_MOCK_PAYMENT="false"
PAYMENT_EXPIRY_MINUTES="60"

# Upload gambar: kosongkan SUPABASE_* supaya upload baru disimpan di volume `uploads`.
# Gambar lama yang URL-nya ke Supabase tetap tampil selama project Supabase masih hidup.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"
