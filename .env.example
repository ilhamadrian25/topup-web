DATABASE_URL="postgresql://topup:topup@localhost:5433/topup?schema=public"
# Koneksi langsung untuk prisma migrate (Supabase: port 5432). Lokal: sama dengan DATABASE_URL.
DIRECT_URL="postgresql://topup:topup@localhost:5433/topup?schema=public"

# Secret untuk JWT session (min 32 karakter). Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Base URL publik (dipakai untuk callback/redirect)
APP_URL="http://localhost:3000"

# Biller: "mock" | "payterra"
BILLER_PROVIDER="mock"
# Payterra merchant API (belum tersedia di sisi Payterra — dipakai saat BILLER_PROVIDER=payterra)
PAYTERRA_BASE_URL=""
PAYTERRA_MERCHANT_ID=""
PAYTERRA_API_KEY=""
PAYTERRA_CALLBACK_SECRET=""

# Payment gateway TIDAK diatur di env — kelola di Admin → Payment Gateway (tersimpan di DB).
# Kunci enkripsi kredensial gateway di DB (opsional, default AUTH_SECRET). Jangan diganti setelah dipakai.
CONFIG_ENCRYPTION_KEY=""
# Izinkan gateway MOCK di produksi (default: hanya di development)
ALLOW_MOCK_PAYMENT="false"
# Menit sebelum invoice kedaluwarsa
PAYMENT_EXPIRY_MINUTES="60"

# Admin awal yang dibuat oleh seed
SEED_ADMIN_EMAIL="admin@topup.local"
SEED_ADMIN_PASSWORD="admin12345"

# Folder upload gambar admin (logo/banner). Mount ke volume persisten di produksi.
UPLOAD_DIR="uploads"

# Supabase Storage untuk gambar upload admin (wajib di Vercel; kosong = disk lokal UPLOAD_DIR)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"
